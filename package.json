{
  "name": "dsh-extension-lab",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "pnpm --dir packages/dsh-ui-diy run build:dev",
    "build": "pnpm --dir packages/dsh-ui-diy run build",
    "test": "pnpm --dir packages/dsh-ui-diy test",
    "release:check": "node scripts/release.mjs check",
    "release:prepare": "node scripts/release.mjs prepare",
    "release:publish": "node scripts/release.mjs publish"
  }
}
