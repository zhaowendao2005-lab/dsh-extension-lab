{
  "name": "dsh-antigravity-acp",
  "version": "0.1.2",
  "private": true,
  "description": "Isolated local Antigravity ACP model adapter for DSH. Generation remains blocked pending authoritative native-tool purity verification.",
  "type": "module",
  "main": "./lib/host/index.js",
  "exports": {
    ".": "./lib/host/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "integration",
    "locale",
    "icon.svg",
    "README.md",
    "docs"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check.mjs",
    "probe": "node scripts/probe.mjs"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./integration/cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.2-rc.3 <0.3.0-0",
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.3 <0.3.0-0",
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.26.0",
    "ajv": "8.17.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-error": "0.2.2-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.3",
    "@deepseek-ai/schemastery": "3.19.0"
  }
}
