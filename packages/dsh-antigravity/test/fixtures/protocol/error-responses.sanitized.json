          "code": 429,
          "message": "Rate limit exceeded",
          "status": "RESOURCE_EXHAUSTED"
        }
      }
    },
    "quotaExhaustedWithResetDelay": {
      "status": 429,
      "headers": {},
      "body": {
        "error": {
