{
  "name": "dsh-workspace-ide",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DSH 全局面板：文件树 / SCM / 提交图谱 + 编辑器与 diff + 真 PTY 终端",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "integration",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:dev": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "test": "node scripts/build.mjs --check"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./integration/cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-shortcuts"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0-0",
    "node": "^22.19.0 || >=24.0.0"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-sandbox": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-sandbox": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    }
  },
  "devDependencies": {
    "@codemirror/commands": "^6",
    "@codemirror/lang-cpp": "^6",
    "@codemirror/lang-css": "^6",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6",
    "@codemirror/lang-java": "^6",
    "@codemirror/lang-javascript": "^6",
    "@codemirror/lang-json": "^6",
    "@codemirror/lang-markdown": "^6",
    "@codemirror/lang-php": "^6",
    "@codemirror/lang-python": "^6",
    "@codemirror/lang-rust": "^6",
    "@codemirror/lang-sql": "^6",
    "@codemirror/lang-xml": "^6",
    "@codemirror/lang-yaml": "^6",
    "@codemirror/language": "^6",
    "@codemirror/merge": "^6",
    "@codemirror/search": "^6",
    "@codemirror/state": "^6",
    "@codemirror/view": "^6",
    "@lezer/highlight": "^1.2.5",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "esbuild": "0.25.12",
    "zustand": "^5"
  }
}
