{
  "name": "extension-lab-manager",
  "version": "1.1.0",
  "private": true,
  "description": "Private DSH extension catalog manager with install and update actions.",
  "type": "module",
  "exports": { ".": "./lib/index.js", "./client": "./lib/client.js" },
  "files": ["lib", "cordis.patch.yml", "README.md"],
  "scripts": { "build": "node scripts/build.mjs", "build:dev": "node scripts/build.mjs --development", "build:production": "node scripts/build.mjs --production" },
  "dsh": {
    "manifestVersion": 1,
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "inject": ["@deepseek-ai/dsh-client-ui-plugin-manager"], "platform": "web" }
  },
  "engines": { "dsh": ">=0.2.0-rc.1 <0.3.0-0", "node": "^22.19.0 || >=24.0.0" }
}
