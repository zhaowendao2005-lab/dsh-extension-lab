{
  "name": "dsh-plugin-dev-sandbox",
  "version": "1.0.1",
  "private": true,
  "description": "Workspace-scoped DSH plugin development sandbox and debug panel.",
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "dsh": ">=0.2.0-rc.1 <0.3.0-0",
    "node": "^22.19.0 || >=24.0.0"
  }
}
