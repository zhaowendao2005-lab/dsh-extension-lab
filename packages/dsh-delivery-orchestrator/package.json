{
  "name": "dsh-delivery-orchestrator",
  "version": "0.2.0",
  "private": true,
  "description": "Isolated, durable delivery orchestration for DSH",
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": ["lib", "integration", "locale", "icon.svg", "README.md"],
  "scripts": { "build": "node scripts/build.mjs" },
  "dsh": {
    "manifestVersion": 1,
    "bundle": { "patch": "./integration/cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-api-remotes", "@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-ui-slots"]
    }
  },
  "engines": { "dsh": ">=0.2.2-rc.1 <0.3.0-0", "node": "^22.19.0 || >=24.0.0" },
  "dependencies": { "zod": "4.4.3" },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-storage-domain": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-storage-domain": { "optional": true },
    "@deepseek-ai/dsh-typert-protocol": { "optional": true }
  }
}
