# 会话开发绑定与隔离运行时（不得提交凭据或日志）
.dsh/
.playwright-cli/
.dsh_plugin_dev/
.dsh-plugin-dev.json
# DSH 开发环境与依赖
node_modules/
.DS_Store
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 构建产物与缓存
dist/
lib/
# 但插件包发布的 lib/ 产物需要入库
!packages/*/lib/
build/
.turbo/
.eslintcache
.stylelintcache

# DSH/VS Code 特定配置
.vscode/
.idea/
*.local

# 开发实例产生的文件
tmp/
*.tmp

# 官方 DSH 桌面端 app.asar 的本地解包（仅用于查 API，勿提交）
extracted_files/

# 工具缓存与统计报告
.pnpm-store/
.VSCodeCounter/

# MITM 抓包与临时实验数据（防凭据泄露与大文件入库）
*.mitm
capture/*.jsonl
capture/cli-prompt.txt

# 构建副产物与调试映射
*.map
*.tsbuildinfo

# 本地环境变量
.env
.env.*
!.env.example
